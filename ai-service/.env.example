PORT=5000

# Which AI to use: groq (default) or gemini
AI_PROVIDER=groq

# Groq: free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b


# Shared secret with the backend (same value as INTERNAL_API_KEY in backend/.env)
INTERNAL_API_KEY=
