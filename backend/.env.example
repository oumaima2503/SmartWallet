PORT=4000
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me
# Shared secret with the AI service (same value as in ai-service/.env)
INTERNAL_API_KEY=

# Production (Render) only:
# NODE_ENV=production
# FRONTEND_URL=https://your-app.vercel.app   (the Vercel address, no slash at the end)
# AI_SERVICE_URL=https://your-ai-service.onrender.com
# TRUST_PROXY=2   (Vercel + Render proxies in front of the app)
