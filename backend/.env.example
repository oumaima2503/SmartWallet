PORT=4000
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Temporary: user used by all requests until login is built
DEMO_USER_ID=1
# Shared secret with the AI service (same value as in ai-service/.env)
INTERNAL_API_KEY=
